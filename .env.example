
DATA_DIR=${HOME}/Box/2026-glaciers/

# Optional Label Studio overrides for hand-labeling (see labelstudio/README.md).
# The defaults below are already applied, so you only need these lines to change something.
# Note that DATA_DIR must be an absolute path, start with ./, or start with ${HOME} -- docker compose does not
# expand a leading ~, even though the Python code in src/utils/settings.py does.
#LABELSTUDIO_USERNAME=labeler@example.com
#LABELSTUDIO_PASSWORD=glaciers2026
#LABELSTUDIO_TOKEN=clinic2026glaciersdevtoken
# Subdirectory of DATA_DIR that holds the .h5 frames. Unset means DATA_DIR itself.
#LABELSTUDIO_IMAGE_SUBDIR=
#TILESERVER_URL=http://localhost:8081
# Tile edge in pixels, a multiple of 512. Smaller tiles submit faster when a tile has many regions.
#TILESERVER_TILE_SIZE=4096
