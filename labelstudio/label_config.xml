<!--
  Labeling interface for glacier crevasse segmentation.

  The mask encodes confidence directly: each brush label is a confidence level, painted in a
  different shade of orange. Unpainted pixels are "not a crevasse". The shades are warm and
  spaced in lightness so they stay distinct from each other and from both grayscale and
  natural-color glacier imagery.

  To add or rename a class, edit the <Label> list below and re-run ./labelstudio/setup.sh.
  Note that changing this after people have started labeling does NOT backfill annotations
  that were already submitted.

  Two things that look like bugs if you get them wrong:
    * Controls render in document order, so BrushLabels must stay ABOVE <Image>. Below a tall
      image it scrolls out of view, and a brush with no label selected silently refuses to
      paint.
    * Selecting a label while a region is selected RELABELS that region instead of starting a
      new stroke in the new color. Labelers must deselect (U) before switching confidence.
-->
<View>
  <!-- Which frame and tile this is. Set per task by setup.sh. -->
  <Header value="$title" size="6"/>
  <Header size="6" underline="false"
          value="Paint all strokes of one color, then press U before picking the next color."/>

  <BrushLabels name="mask" toName="image">
    <Label value="low" background="#FFC04D" hotkey="1"
           hint="Poor image quality, or you are unsure whether these pixels are a crevasse."/>
    <Label value="medium" background="#FF7F00" hotkey="2"
           hint="Mostly clear, but a judgment call or a faint feature."/>
    <Label value="high" background="#B33C00" hotkey="3"
           hint="Unambiguously a crevasse."/>
  </BrushLabels>

  <Image name="image" value="$image"
         zoom="true" zoomControl="true"
         brightnessControl="true" contrastControl="true"
         rotateControl="false" crosshair="true"/>
</View>
